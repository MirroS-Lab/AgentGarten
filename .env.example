# Machine-local settings. Copy to `.env` (gitignored); scripts/run.sh and
# wm.train read it. Variables already exported in the shell take precedence.

# Interpreter with wm installed (default: `python` on PATH).
#WM_PYTHON=/path/to/envs/wm/bin/python

# Large node-local volume for torch.compile / Triton / CUDA caches and NCCL dumps.
#WM_RUNTIME_CACHE_ROOT=/path/to/fast/volume/wm-cache

# Released weights.
#WM_COSMOS3_NANO=/path/to/Cosmos3-Nano
#WM_WAN22_VAE=/path/to/Wan2.2-TI2V-5B/Wan2.2_VAE.pth

# Data manifests (JSONL, see wm/data/video.py) and the run output root.
#WM_TRAIN_MANIFEST=/path/to/train.jsonl
#WM_VAL_MANIFEST=/path/to/val.jsonl
#WM_OUTPUT_ROOT=/path/to/runs

# Weights & Biases credential used by the wandb metric sink.
#WANDB_API_KEY=
